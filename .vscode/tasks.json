{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run",
			"type": "shell",
			"command": "./mvnw spring-boot:run",
			"group": "build",
			"problemMatcher": "$java",
			"isBackground": true
		},
		{
			"label": "Test",
			"type": "shell",
			"command": "./mvnw test",
			"group": "test",
			"problemMatcher": "$java"
		},
		{
			"label": "Package",
			"type": "shell",
			"command": "./mvnw package",
			"group": "build",
			"problemMatcher": "$java"
		}
	]
}
